# `argus verify` compares generated files byte-for-byte with a fresh build, so their
# line endings must not depend on the platform or core.autocrlf.
# CSVs are written by Python's csv module (CRLF); JSON/JSONL with LF.
*.csv                     text eol=crlf
data/processed/*.jsonl    text eol=lf
datapackage.json          text eol=lf
CITATION.cff              text eol=lf
# External raw files are kept byte-identical to the download (their sha256 is checked).
data/external/*/raw/**    -text
# Curated external tables are checksummed in data/external/sources.yaml: keep them byte-stable.
data/external/*/*.csv      -text
